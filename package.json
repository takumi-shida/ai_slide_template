{
  "name": "ai-slide-template",
  "version": "0.1.0",
  "private": true,
  "description": "Local template packs and deterministic Google Slides editing for existing AI subscriptions",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "bin": { "ai-slide-template": "bin/ai-slide-template.js" },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/google-smoke.mjs",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "dependencies": { "ajv": "8.17.1", "jszip": "3.10.1", "xml-js": "1.6.11" },
  "devDependencies": { "@types/node": "24.10.1", "esbuild": "0.25.12", "pptxgenjs": "4.0.1", "typescript": "7.0.2" },
  "license": "MIT"
}
